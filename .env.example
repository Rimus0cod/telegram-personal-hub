# Required: token from @BotFather. Never commit the real value.
BOT_TOKEN=replace_with_botfather_token

# Required: public HTTPS URL of the Mini App (must match BotFather).
WEBAPP_URL=https://your-public-domain.example

# Optional: only needed for `docker compose --profile tunnel`.
NGROK_AUTHTOKEN=

# Required: strong PostgreSQL password. Compose refuses to start without it.
# Use URL-safe characters or percent-encode special characters used in DATABASE_URL.
POSTGRES_PASSWORD=replace_this_password

# Optional: backend outside Compose can use a local Redis. Compose starts its
# own redis service and connects to it internally regardless of this value.
REDIS_URL=redis://localhost:6379/0

# Optional: Redis operation timeout for rate limiting (seconds).
REDIS_TIMEOUT_SECONDS=0.25

# Optional: Telegram initData max age in seconds (default 24 hours).
INIT_DATA_MAX_AGE=86400

# Optional: host port for the frontend container.
PORT=8080
